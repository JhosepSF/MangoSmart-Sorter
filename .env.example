DEBUG=True
SECRET_KEY=django-insecure-mango-sort-ai-default-key-12345
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
REDIS_URL=redis://localhost:6379/0

# Inferencia: 'mock' (simulado) o 'real' (utiliza el modelo ConvNeXt-Tiny)
ML_MODEL_MODE=mock
ML_MODEL_PATH=ml_models/best_convnext_tiny.pth
ML_CONFIG_PATH=ml_models/model_config.json

# Arduino: 'mock' (simulado) o 'real'
ARDUINO_MODE=mock
ARDUINO_PORT=COM3
ARDUINO_BAUDRATE=9600
ARDUINO_TIMEOUT_SECONDS=2

# Configuración adicional
MAX_IMAGE_SIZE_MB=8
MEDIA_ROOT=media
CONFIDENCE_THRESHOLD=0.80
